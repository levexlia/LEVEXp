PORT=3000
# JSON file for the single player, goals, XP, photos, and the room. Created on first boot.
# Relative to the process working directory.
# `npm run start:api` runs in apps/api, so the default file is apps/api/data/levexp.json.
# Uploaded images are written next to this file, in an `uploads` directory
# (default: ./data/uploads, i.e. apps/api/data/uploads when the API is started via npm).
DATA_FILE=./data/levexp.json

# Персонаж из фото. Ключ читает только процесс API. Без ключа сервер рисует
# локальные заглушки и никуда фото не отправляет.
# OPENAI_API_KEY=
# gpt-image-1 отключён 23 октября 2026. Пустое значение — gpt-image-2.5-sunburst.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium
# Если ключа OpenAI нет, можно поставить ключ xAI. Пустой AVATAR_PROVIDER
# выбирает OpenAI, затем xAI, затем mock.
# XAI_API_KEY=
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# AVATAR_PROVIDER=mock
# Генераций в сутки (UTC) на файл игрока. Каждая возвращает 2–4 картинки.
# AVATAR_DAILY_LIMIT=5
# AVATAR_CANDIDATE_COUNT=3
