PORT=3000
# JSON file for the single player, goals, XP, photos, and the room. Created on first boot.
# Relative to the process working directory.
# `npm run start:api` runs in apps/api, so the default file is apps/api/data/levexp.json.
# Uploaded images are written next to this file, in an `uploads` directory
# (default: ./data/uploads, i.e. apps/api/data/uploads when the API is started via npm).
DATA_FILE=./data/levexp.json
